{
  "name": "@pangza/core",
  "version": "1.0.2",
  "description": "Application / IoC / Logger / config / Json / Validate / Exception",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./*": {
      "types": "./dist/*.d.ts",
      "require": "./dist/*.js",
      "import": "./dist/*.js",
      "default": "./dist/*.js"
    }
  },
  "typesVersions": {
    "*": {
      "*": [
        "dist/*",
        "dist/*/index.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "js-yaml": "^5.5.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "validator": "^13.15.35"
  },
  "peerDependencies": {
    "express": "^4.18.0 || ^5.0.0",
    "inversify": "^6.0.0 || ^8.0.0",
    "reflect-metadata": "^0.1.13 || ^0.2.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.5.0",
    "@types/validator": "^13.15.10",
    "express": "^5.2.1",
    "inversify": "^8.2.3",
    "reflect-metadata": "^0.2.2",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  }
}
